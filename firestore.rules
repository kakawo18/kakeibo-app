rules_version = '2';

// 家計簿アプリの Firestore セキュリティルール
//
// このアプリはクライアントから直接 Firestore を読み書きする（サーバー側の API 層が無い）。
// つまり、他人のデータへのアクセスを止めているのはこのファイルだけである。
//
// デプロイ:
//   firebase deploy --only firestore:rules
//   （または Firebase Console → Firestore Database → ルール に貼り付け）
//
// データ構成:
//   transactions/{id}                       … 取引。userId フィールドで所有者を持つ
//   users/{uid}/settings/app                … カテゴリ・支払方法・月間予算・グラフの表示設定
//   users/{uid}/recurringTransactions/{id}  … 定期取引
//   oauthAuthorizationCodes/{hash}          … Claude 連携の認可コード（サーバーの Admin SDK だけが使う）
//   oauthRefreshTokens/{hash}               … Claude 連携のリフレッシュトークン（同上）
//
// Admin SDK はこのルールを通らない。サーバー（src/server）が読む利用者のデータは、
// コードの側で uid に絞っている（docs/claude-connector/仕様書.md 7.2）。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 書き込みの形と大きさの検査（#163）
    //
    // 新規登録は誰でもできる（#66）ため、自分の領域にでも任意のフィールド・任意の大きさの
    // データを書けると、第三者が Firestore の容量（Spark プランは 1 GiB）を使い切れてしまう。
    // そこで、作成ではアプリが書くフィールドだけを許し、文字列の長さに上限を設ける。
    //
    // 更新では「今回変わったフィールド」（affectedKeys）だけを検査する。ドキュメント全体を
    // 検査すると、上限を入れる前に保存された長いメモなどを持つ既存データが、別の項目の
    // 編集まで拒否されてしまうため。上限の値は src/utils/validation.ts と揃える。

    // key が無いか、max 文字以下の文字列
    function isShortString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // key が無いか、1〜max 文字の文字列
    function isName(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() > 0 && data[key].size() <= max);
    }

    function isTimestampOrAbsent(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    // 更新で変わったフィールド
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 取引データ（トップレベルコレクション）
    match /transactions/{transactionId} {
      function isOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      function isValidNewTransaction() {
        let incoming = request.resource.data;
        return isSignedIn()
          && incoming.userId == request.auth.uid
          && incoming.type in ['income', 'expense']
          && incoming.amount is number
          && incoming.amount >= 0
          && incoming.category is string
          && incoming.category.size() > 0
          && incoming.category.size() <= 50
          && incoming.date is timestamp;
      }

      // アプリが書く取引のフィールド（src/data/transactionSerializer.ts と transactionRepository.ts）
      function transactionFields() {
        return ['userId', 'type', 'amount', 'category', 'subcategory', 'paymentMethod',
          'description', 'date', 'transactionType', 'affectsExpense',
          'recurringTransactionId', 'recurringMonth', 'createdAt', 'updatedAt'];
      }

      // keys に入っている任意項目だけを検査する（作成では全キー、更新では変わったキー）
      function hasValidOptionalFields(keys) {
        let data = request.resource.data;
        return (!('subcategory' in keys) || isShortString(data, 'subcategory', 50))
          && (!('paymentMethod' in keys) || isShortString(data, 'paymentMethod', 50))
          && (!('description' in keys) || isShortString(data, 'description', 200))
          && (!('transactionType' in keys) || !('transactionType' in data)
            // card_withdrawal は廃止済みのレガシー値だが、CSV の復元で書き戻すことがある
            || data.transactionType in ['normal', 'card_payment', 'card_withdrawal'])
          && (!('affectsExpense' in keys) || !('affectsExpense' in data) || data.affectsExpense is bool)
          && (!('recurringTransactionId' in keys) || isShortString(data, 'recurringTransactionId', 100))
          && (!('recurringMonth' in keys) || !('recurringMonth' in data)
            || (data.recurringMonth is string && data.recurringMonth.matches('[0-9]{4}-[0-9]{2}')))
          && (!('createdAt' in keys) || isTimestampOrAbsent(data, 'createdAt'))
          && (!('updatedAt' in keys) || isTimestampOrAbsent(data, 'updatedAt'));
      }

      allow read, delete: if isOwner();
      allow create: if isValidNewTransaction()
        && request.resource.data.keys().hasOnly(transactionFields())
        && hasValidOptionalFields(request.resource.data.keys());
      // 所有者の付け替え（他人への譲渡・なりすまし）を禁止する
      allow update: if isOwner()
        && isValidNewTransaction()
        && request.resource.data.userId == resource.data.userId
        && changedKeys().hasOnly(transactionFields())
        && hasValidOptionalFields(changedKeys());
    }

    // ユーザー設定（カテゴリ・支払方法・月間予算・グラフの表示設定）
    // カテゴリなどの配列の中身はルールでは検査しきれないので、件数とトップレベルのキーに絞る。
    // パスが1つに決まっているので、1人あたりの大きさは 1 ドキュメント（最大 1 MiB）に収まる
    match /users/{userId}/settings/app {
      function settingsFields() {
        return ['schemaVersion', 'monthlyBudget', 'categories', 'paymentMethods',
          'chartPreferences', 'createdAt', 'updatedAt'];
      }

      function hasValidSettingsFields(keys) {
        let data = request.resource.data;
        return (!('schemaVersion' in keys) || !('schemaVersion' in data) || data.schemaVersion is int)
          && (!('monthlyBudget' in keys) || !('monthlyBudget' in data) || data.monthlyBudget is number)
          && (!('categories' in keys) || !('categories' in data)
            || (data.categories is list && data.categories.size() <= 200))
          && (!('paymentMethods' in keys) || !('paymentMethods' in data)
            || (data.paymentMethods is list && data.paymentMethods.size() <= 100))
          && (!('chartPreferences' in keys) || !('chartPreferences' in data)
            || (data.chartPreferences is map
              && (!('categoryTrendCategories' in data.chartPreferences)
                || (data.chartPreferences.categoryTrendCategories is list
                  && data.chartPreferences.categoryTrendCategories.size() <= 200))))
          && (!('createdAt' in keys) || isTimestampOrAbsent(data, 'createdAt'))
          && (!('updatedAt' in keys) || isTimestampOrAbsent(data, 'updatedAt'));
      }

      function isSelf() {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow read, delete: if isSelf();
      allow create: if isSelf()
        && request.resource.data.keys().hasOnly(settingsFields())
        && hasValidSettingsFields(request.resource.data.keys());
      allow update: if isSelf()
        && changedKeys().hasOnly(settingsFields())
        && hasValidSettingsFields(changedKeys());
    }

    // 定期取引（src/data/recurringTransactionSerializer.ts）
    match /users/{userId}/recurringTransactions/{recurringId} {
      function recurringFields() {
        return ['name', 'amount', 'category', 'subcategory', 'paymentMethod', 'dayOfMonth',
          'isEnabled', 'createdAt', 'updatedAt'];
      }

      function hasValidRecurringFields(keys) {
        let data = request.resource.data;
        return (!('name' in keys) || isName(data, 'name', 50))
          && (!('amount' in keys) || !('amount' in data) || (data.amount is number && data.amount >= 0))
          && (!('category' in keys) || isName(data, 'category', 50))
          && (!('subcategory' in keys) || isShortString(data, 'subcategory', 50))
          && (!('paymentMethod' in keys) || isShortString(data, 'paymentMethod', 50))
          && (!('dayOfMonth' in keys) || !('dayOfMonth' in data)
            || (data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31))
          && (!('isEnabled' in keys) || !('isEnabled' in data) || data.isEnabled is bool)
          && (!('createdAt' in keys) || isTimestampOrAbsent(data, 'createdAt'))
          && (!('updatedAt' in keys) || isTimestampOrAbsent(data, 'updatedAt'));
      }

      function isSelf() {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow read, delete: if isSelf();
      allow create: if isSelf()
        && request.resource.data.keys().hasOnly(recurringFields())
        && request.resource.data.keys().hasAll(['name', 'amount', 'category', 'dayOfMonth', 'isEnabled'])
        && hasValidRecurringFields(request.resource.data.keys());
      allow update: if isSelf()
        && changedKeys().hasOnly(recurringFields())
        && hasValidRecurringFields(changedKeys());
    }

    // users/{uid} 配下のそれ以外のパス（任意のサブコレクションなど）は、末尾の「全て拒否」に落ちる

    // Claude 連携の認可コードとリフレッシュトークン。
    // サーバー（Admin SDK）だけが読み書きし、クライアントからは本人のものでも一切触らせない。
    // 下の「全て拒否」でも拒否されるが、意図を残すために名指しする
    match /oauthAuthorizationCodes/{codeHash} {
      allow read, write: if false;
    }
    match /oauthRefreshTokens/{tokenHash} {
      allow read, write: if false;
    }

    // 上記に当てはまらないパスは全て拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
