# Firebase 設定
# 取得方法: Firebase Console (https://console.firebase.google.com/)
#   → プロジェクトを選択 → プロジェクトの設定（歯車アイコン）
#   → 「全般」タブ → 「マイアプリ」→ ウェブアプリの firebaseConfig の値をコピー
#
# このファイルを .env.local にコピーして、各値を自分の Firebase プロジェクトの値に置き換えてください。
# 注意: アカウント（メール/パスワード）は Firebase プロジェクトごとに独立しています。
#       別のプロジェクトの設定値に切り替えると、以前のアカウントではログインできません。

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# 任意: Google Analytics を使う場合のみ
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# 任意: ローカルの Firebase エミュレータに接続する場合は 1 を設定
# NEXT_PUBLIC_FIREBASE_EMULATOR=1

# 任意: Firebase App Check を有効にする場合の reCAPTCHA v3 サイトキー
# 取得方法: Firebase Console → App Check → アプリを登録（reCAPTCHA v3）
# 設定すると App Check が初期化される。未設定なら無効のまま動く。
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxx

# 任意: Claude 連携（docs/claude-connector/）をローカルで試す場合
# Admin SDK をエミュレータに向け、開発サーバーでだけ認証を省いて MCP_DEV_UID の利用者として扱う。
# 本番（NODE_ENV=production）では、この2つがあっても認証は省かれない。
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# MCP_DEV_UID=エミュレータで作ったテストユーザーの uid
