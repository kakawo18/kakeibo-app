{
  "name": "kakeibo-app",
  "version": "6.11.2",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "npx --yes firebase-tools@13 emulators:exec --only firestore --project demo-kakeibo \"vitest run -c vitest.emulator.config.ts\"",
    "test:e2e": "npx --yes firebase-tools@13 emulators:exec -c firebase.e2e.json --only auth,firestore --project demo-kakeibo \"playwright test\"",
    "build:analyze": "ANALYZE=true npm run build",
    "postinstall": "npm run type-check"
  },
  "dependencies": {
    "@mantine/charts": "^8.1.1",
    "@mantine/core": "^8.1.1",
    "@mantine/dates": "^8.1.1",
    "@mantine/form": "^8.1.1",
    "@mantine/hooks": "^8.1.1",
    "@mantine/modals": "^8.1.1",
    "@mantine/notifications": "^8.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@tabler/icons-react": "^3.34.0",
    "dayjs": "^1.11.13",
    "firebase": "^11.9.1",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.23.0",
    "jose": "^6.2.13",
    "mcp-handler": "^2.3.0",
    "next": "^16.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
