{
  "name": "kakeibo-app",
  "version": "6.4.9",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "npx --yes firebase-tools@13 emulators:exec --only firestore --project demo-kakeibo \"vitest run -c vitest.emulator.config.ts\"",
    "build:analyze": "ANALYZE=true npm run build",
    "postinstall": "npm run type-check"
  },
  "dependencies": {
    "@mantine/charts": "^8.1.1",
    "@mantine/core": "^8.1.1",
    "@mantine/dates": "^8.1.1",
    "@mantine/form": "^8.1.1",
    "@mantine/hooks": "^8.1.1",
    "@mantine/modals": "^8.1.1",
    "@mantine/notifications": "^8.1.1",
    "@tabler/icons-react": "^3.34.0",
    "dayjs": "^1.11.13",
    "firebase": "^11.9.1",
    "framer-motion": "^12.23.0",
    "next": "^16.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
